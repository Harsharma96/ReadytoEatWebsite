{
  "name": "foodeat-root",
  "version": "1.0.0",
  "private": true,
  "description": "FoodEat Luxury Culinary Platform Workspace",
  "scripts": {
    "dev": "concurrently -n \".NET_API,FRONTEND\" -c \"cyan,green\" \"dotnet run --project backend --urls=http://localhost:5000\" \"npm run dev --prefix frontend\"",
    "dev:backend": "dotnet run --project backend --urls=http://localhost:5000",
    "dev:frontend": "npm run dev --prefix frontend",
    "start": "concurrently -n \".NET_API,FRONTEND\" -c \"cyan,green\" \"dotnet run --project backend --urls=http://localhost:5000\" \"npm start --prefix frontend\"",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
